{
  "name": "@kreeger/pi-edit-split",
  "version": "0.1.0",
  "description": "A side-by-side diff preview for the pi-coding-agent edit tool.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "edit",
    "diff",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreeger/pi-edit-split.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": "Ben Kreeger",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "deploy": "tsx src/_helpers/install.ts",
    "release": "release-it"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/node": "^25.6.0",
    "release-it": "^21.0.2",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
